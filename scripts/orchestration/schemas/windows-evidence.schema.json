{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade.local/schemas/windows-evidence.schema.json",
  "title": "Evidências do ambiente Windows",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collectedAtUtc", "collectorVersion", "platform", "powershell", "git", "docker", "wsl", "environment"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "collectedAtUtc": { "type": "string", "format": "date-time" },
    "collectorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "machineNameHash"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "machineNameHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "powershell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition", "version"],
      "properties": {
        "edition": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "git": { "$ref": "#/$defs/gitEvidence" },
    "docker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "compose"],
      "properties": {
        "version": { "$ref": "#/$defs/commandEvidence" },
        "compose": { "$ref": "#/$defs/commandEvidence" }
      }
    },
    "wsl": { "$ref": "#/$defs/commandEvidence" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CI", "WSL_DISTRO_NAME", "DOCKER_HOST"],
      "properties": {
        "CI": { "type": "boolean" },
        "WSL_DISTRO_NAME": { "type": "boolean" },
        "DOCKER_HOST": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "commandEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "output"],
      "properties": {
        "status": { "enum": ["disponivel", "indisponivel", "erro"] },
        "exitCode": { "type": ["integer", "null"] },
        "output": { "type": ["string", "null"] }
      }
    },
    "gitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "status"],
      "properties": {
        "version": { "$ref": "#/$defs/commandEvidence" },
        "revision": { "$ref": "#/$defs/commandEvidence" },
        "status": { "$ref": "#/$defs/commandEvidence" }
      }
    }
  }
}
