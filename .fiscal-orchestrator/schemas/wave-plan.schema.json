{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fiscal Platform Wave Plan",
  "type": "object",
  "required": ["schemaVersion", "project", "baseline", "phase", "officialSlots", "extras", "sharedFiles", "decisions", "pendingProof"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "project": {"type": "string", "const": "fiscal-platform"},
    "baseline": {
      "type": "object",
      "required": ["branch", "expression", "commit"],
      "properties": {
        "branch": {"type": "string"},
        "expression": {"type": "string"},
        "commit": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "phase": {"type": "string"},
    "serialGate": {
      "type": ["object", "null"],
      "properties": {
        "itemId": {"type": "string"},
        "reason": {"type": "string"},
        "prompt": {"type": "string"}
      },
      "required": ["itemId", "reason", "prompt"],
      "additionalProperties": false
    },
    "officialSlots": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/slot"}},
    "futureOfficialWave": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/slot"}},
    "extras": {"type": "array", "items": {"$ref": "#/$defs/slot"}},
    "sharedFiles": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "pendingProof": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "slot": {
      "type": "object",
      "required": ["slot", "itemId", "taskType", "title", "baseline", "ownedPaths", "excludedPaths", "dependencies", "prompt"],
      "properties": {
        "slot": {"type": ["integer", "string"]},
        "itemId": {"type": "string"},
        "taskType": {"type": "string", "enum": ["ANALYSIS", "DECISION", "IMPLEMENTATION", "BUG_FIX", "TEST", "RECONCILIATION", "ENVIRONMENT"]},
        "title": {"type": "string"},
        "baseline": {"type": "string"},
        "ownedPaths": {"type": "array", "items": {"type": "string"}},
        "excludedPaths": {"type": "array", "items": {"type": "string"}},
        "migrationOwnership": {"type": ["string", "null"]},
        "dependencies": {"type": "array", "items": {"type": "string"}, "maxItems": 0},
        "prompt": {"type": "string"},
        "pendingProof": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
