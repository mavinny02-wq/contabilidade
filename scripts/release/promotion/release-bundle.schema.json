{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade.local/schemas/release-bundle.v1.json",
  "title": "Contabilidade immutable release promotion bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseVersion", "gitCommit", "createdAt", "components", "flywayFrontier", "sourceEnvironment", "targetEnvironment", "evidenceIds", "rollbackTarget"],
  "properties": {
    "releaseVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "createdAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "components": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "imageRepository", "imageDigest", "sbomSha256", "provenanceSha256"],
        "properties": {
          "name": {"type": "string"}, "imageRepository": {"type": "string"},
          "imageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sbomSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "provenanceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "flywayFrontier": {"type": "integer", "minimum": 0},
    "sourceEnvironment": {"type": "string"}, "targetEnvironment": {"type": "string"},
    "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rollbackTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["releaseVersion", "gitCommit", "flywayFrontier"],
      "properties": {
        "releaseVersion": {"type": "string"}, "gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "flywayFrontier": {"type": "integer", "minimum": 0}
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "reason", "transition", "expiresAt"],
      "properties": {
        "owner": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1},
        "transition": {"type": "string", "pattern": "^[a-z-]+->[a-z-]+$"},
        "expiresAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      }
    }
  }
}
