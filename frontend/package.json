{
  "name": "contabilidade-frontend",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "locale:validate": "node scripts/validate-locale.mjs",
    "install:locked": "npm install --no-audit --no-fund"
  },
  "dependencies": {
    "i18next": "25.10.10",
    "keycloak-js": "26.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.6",
    "react-router-dom": "7.15.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
