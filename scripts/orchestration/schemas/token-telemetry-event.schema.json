{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contabilidade.local/schemas/token-telemetry-event.schema.json",
  "title": "Token outcome telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": ["waveId", "item", "dispatchKey", "model", "executor", "inputTokens", "outputTokens", "origin", "category", "outcome", "classification", "timestamp", "fingerprint"],
  "properties": {
    "waveId": {"type": "string", "minLength": 1}, "item": {"type": "string", "minLength": 1},
    "dispatchKey": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
    "executor": {"type": "string", "minLength": 1}, "inputTokens": {"type": "integer", "minimum": 0},
    "outputTokens": {"type": "integer", "minimum": 0}, "cachedTokens": {"type": "integer", "minimum": 0},
    "reasoningTokens": {"type": "integer", "minimum": 0},
    "origin": {"enum": ["PROVIDER_REPORTED", "LOCAL_ESTIMATE"]}, "category": {"enum": ["HOT", "WARM", "COLD"]},
    "outcome": {"type": "string", "minLength": 1}, "classification": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "minLength": 1}, "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contextFingerprint": {"type": "string", "minLength": 1}, "redactedFields": {"type": "array", "items": {"type": "string"}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["amount", "tableId"], "properties": {"amount": {"type": "string"}, "currency": {"type": "string", "minLength": 1}, "tableId": {"type": "string", "minLength": 1}}}
  }
}
