COMPOSE_PROJECT_NAME=contabilidade

POSTGRES_DB=contabilidade
POSTGRES_USER=contabilidade
POSTGRES_PASSWORD=altere-esta-senha
POSTGRES_PORT=5432

KEYCLOAK_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=altere-esta-senha
KEYCLOAK_REALM_FILE=realm-contabilidade-dev.json

PUBLIC_BASE_URL=http://localhost:8088
APP_PORT=8088

APP_SECURITY_ENABLED=true
APP_STORAGE_LOCAL_PATH=/data/documentos
APP_STORAGE_RECONCILIATION_BATCH_SIZE=1000
APP_STORAGE_RECONCILIATION_MAX_REFERENCES=200000
APP_STORAGE_RECONCILIATION_MAX_FILES=200000
APP_STORAGE_RECONCILIATION_MAX_SAMPLES=20
APP_DOCUMENT_RETENTION_INACTIVE_DAYS=365
APP_DOCUMENT_RETENTION_EXPIRED_GRACE_DAYS=365
APP_DOCUMENT_RETENTION_NO_EXPIRY_DAYS=3650
APP_DOCUMENT_RETENTION_PREVIEW_MAX_ROWS=1000
APP_BACKUP_DIRECTORY=/data/backups
APP_BACKUP_INVENTORY_MAX_MANIFESTS=50
APP_BACKUP_MANIFEST_MAX_SIZE_BYTES=1048576
APP_BACKUP_HASH_MAX_COMPONENT_SIZE_BYTES=53687091200
APP_UPDATE_PREFLIGHT_MAX_MANIFEST_SIZE_BYTES=1048576
APP_WORKER_TOKEN=altere-este-token-interno
APP_WORKER_HEARTBEAT_HISTORY_SAMPLE_INTERVAL=PT5M
APP_WORKER_HEARTBEAT_HISTORY_MAX_ROWS=5000
APP_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173

WORKER_POLL_INTERVAL_MS=5000
WORKER_LEASE_SECONDS=180
WORKER_MAX_INTERACTIVE_SESSIONS=2
WORKER_MAX_SSE_SUBSCRIBERS_PER_SESSION=3
WORKER_SHUTDOWN_GRACE_PERIOD_MS=120000
WORKER_SHUTDOWN_SERVER_CLOSE_TIMEOUT_MS=10000
WORKER_SHUTDOWN_STOP_GRACE_PERIOD=130s

# Empresas — importação CSV UTF-8.
APP_COMPANY_CSV_IMPORT_MAX_FILE_SIZE_BYTES=2097152
APP_COMPANY_CSV_IMPORT_MAX_ROWS=2000
APP_COMPANY_CSV_IMPORT_MAX_ERRORS=200

# Auditoria — exportação operacional.
APP_AUDIT_EXPORT_BATCH_SIZE=500
APP_AUDIT_EXPORT_MAX_ROWS=50000

# Centro de Certidões — exportação, dashboard gerencial e agenda.
APP_CERTIFICATE_EXPORT_BATCH_SIZE=500
APP_CERTIFICATE_EXPORT_MAX_ROWS=10000
APP_CERTIFICATE_DASHBOARD_BATCH_SIZE=1000
APP_CERTIFICATE_DASHBOARD_MAX_ROWS=100000
APP_CERTIFICATE_AGENDA_MAX_ROWS=5000

APP_AUTOMATION_PUBLIC_PATH=/automation
APP_AUTOMATION_SESSION_SIGNING_SECRET=altere-este-segredo-de-sessao-com-mais-de-32-caracteres
APP_AUTOMATION_SESSION_TICKET_TTL=PT15M
FEDERAL_PORTAL_URL=https://servicos.receitafederal.gov.br/servico/certidoes
FEDERAL_PORTAL_NAVIGATION_TIMEOUT_MS=60000
FEDERAL_PORTAL_RESULT_TIMEOUT_MS=120000

SEFAZ_SP_PORTAL_URL=https://www10.fazenda.sp.gov.br/CertidaoNegativaDeb/Pages/EmissaoCertidaoNegativa.aspx
SEFAZ_SP_PORTAL_NAVIGATION_TIMEOUT_MS=60000
SEFAZ_SP_PORTAL_RESULT_TIMEOUT_MS=120000
SEFAZ_SP_ENFORCE_SERVICE_WINDOW=true
PGE_SP_PORTAL_URL=https://www.dividaativa.pge.sp.gov.br/sc/pages/crda/emitirCrda.jsf
PGE_SP_PORTAL_NAVIGATION_TIMEOUT_MS=60000
PGE_SP_PORTAL_RESULT_TIMEOUT_MS=120000

# Serpro Consulta CND — provider oficial, desabilitado por padrão no banco.
# Em produção, use Consumer Key e Consumer Secret do contrato do cliente.
SERPRO_CND_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
SERPRO_CND_API_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cnd/v1/certidao
SERPRO_CND_CONSUMER_KEY=
SERPRO_CND_CONSUMER_SECRET=
# Uso controlado em demonstração/preflight. Não configure junto com Consumer Key/Secret em produção.
SERPRO_CND_STATIC_BEARER_TOKEN=
SERPRO_CND_ALLOW_STATIC_BEARER=false
SERPRO_CND_REQUEST_TAG=CONTABILIDADE
SERPRO_CND_HTTP_TIMEOUT_MS=30000
SERPRO_CND_PROCESSING_TIMEOUT_MS=120000
SERPRO_CND_POLL_INTERVAL_MS=750
SERPRO_CND_MAX_PDF_BYTES=10485760
