  },
  "dependencies": {
    "playwright": "1.60.0",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
